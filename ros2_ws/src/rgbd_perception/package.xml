<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rgbd_perception</name>
  <version>0.1.0</version>
  <description>Camera-only RGB-D perception: YOLO26n-seg (RGB-only) + mask-median depth fusion to Object3D + free-space planner. Portable to the real vehicle (same topics/frames).</description>
  <maintainer email="team@skateboard">SKATEBOARD_IRP team</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
